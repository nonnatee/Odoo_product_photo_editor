<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action for Batch Photo Editing -->
        <record id="ir_cron_product_photo_editor_batch" model="ir.cron">
            <field name="name">Product Photo Editor: Bulk Batch Processing</field>
            <field name="model_id" ref="model_product_photo_editor"/>
            <field name="state">code</field>
            <field name="code">model._cron_batch_process()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
