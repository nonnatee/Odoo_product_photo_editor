<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Module Category -->
        <record id="module_category_product_photo_editor" model="ir.module.category">
            <field name="name">Product Photo Editor</field>
            <field name="description">Manage AI product photo processing, connectors, and batch workflows.</field>
            <field name="sequence">60</field>
        </record>

        <!-- Privilege (Odoo 19 3-tier security architecture) -->
        <record id="res_groups_privilege_product_photo_editor" model="res.groups.privilege">
            <field name="name">Product Photo Editor</field>
            <field name="category_id" ref="module_category_product_photo_editor"/>
            <field name="sequence">60</field>
        </record>

        <!-- User Group -->
        <record id="group_photo_editor_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_product_photo_editor"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group -->
        <record id="group_photo_editor_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_product_photo_editor"/>
            <field name="implied_ids" eval="[(4, ref('group_photo_editor_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Multi-company Record Rule -->
        <record id="product_photo_editor_company_rule" model="ir.rule">
            <field name="name">Product Photo Editor Multi-Company</field>
            <field name="model_id" ref="model_product_photo_editor"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
